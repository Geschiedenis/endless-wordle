# Copy to .env.local for local development. Never commit real values.
# Guest play works locally with none of these set. Accounts need the Supabase ones.
# Production builds fail if any of them is missing.

# Encrypts game state. At least 32 characters.
# Generate one with: openssl rand -base64 32
GAME_SECRET=

# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same page. Bypasses all Row Level Security: server only, never expose it,
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The live site, used in search results, shared links and the sitemap.
# Defaults to https://endlesswordle.app. Not required in production.
NEXT_PUBLIC_SITE_URL=
